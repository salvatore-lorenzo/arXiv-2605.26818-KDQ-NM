Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"PartialTrace", "[", 
     RowBox[{"A_", ",", 
      RowBox[{"dim_", "?", "VectorQ"}], ",", "s_"}], "]"}], ":=", 
    RowBox[{"Block", "[", 
     RowBox[{
      RowBox[{"{", "sys", "}"}], ",", "\n", "\t", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"IntegerQ", "[", "s", "]"}], ",", " ", 
         RowBox[{"sys", "=", 
          RowBox[{"{", "s", "}"}]}], ",", " ", 
         RowBox[{"(*", "else", "*)"}], " ", 
         RowBox[{"sys", "=", "s"}]}], "]"}], ";", "\n", "    ", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"Length", "[", "dim", "]"}], " ", "==", " ", "2"}], " ", "&&",
           " ", 
          RowBox[{
           RowBox[{"Length", "[", "sys", "]"}], "==", "1"}]}], ",", "\n", 
         "\t   ", 
         RowBox[{"Switch", "[", 
          RowBox[{
           RowBox[{"sys", "[", 
            RowBox[{"[", "1", "]"}], "]"}], ",", "\n", "        ", "1", ",", 
           " ", 
           RowBox[{"PartialTrace1", "[", 
            RowBox[{"A", ",", "dim"}], "]"}], ",", "\n", "        ", "2", ",",
            " ", 
           RowBox[{"PartialTrace2", "[", 
            RowBox[{"A", ",", "dim"}], "]"}], ",", "\n", "        ", "_", ",",
            " ", 
           RowBox[{"Message", "[", 
            RowBox[{
             RowBox[{"PartialTrace", "::", "sysspecerr"}], ",", " ", 
             RowBox[{"Length", "[", "dim", "]"}], ",", " ", 
             RowBox[{"Select", "[", 
              RowBox[{"sys", ",", " ", 
               RowBox[{
                RowBox[{"Or", "[", 
                 RowBox[{
                  RowBox[{"#", ">", 
                   RowBox[{"Length", "[", "dim", "]"}]}], ",", "  ", 
                  RowBox[{"#", " ", "<", " ", "1"}]}], "]"}], "&"}]}], 
              "]"}]}], "]"}]}], "\n", "        ", "]"}], "\n", "        ", ",", 
         RowBox[{"(*", "else", "*)"}], "\n", "        ", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"Fold", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"#1", " ", "&&", " ", 
               RowBox[{"(", 
                RowBox[{"1", "<=", " ", "#2", " ", "<=", " ", 
                 RowBox[{"Length", "[", "dim", "]"}]}], ")"}]}], "&"}], ",", 
             "True", ",", "sys"}], "]"}], ",", " ", "\n", "        \t", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Union", "[", "sys", "]"}], " ", "==", " ", 
              RowBox[{"Range", "[", 
               RowBox[{"Length", "[", "dim", "]"}], "]"}]}], ",", " ", "\n", 
             "        \t\t", 
             RowBox[{"Tr", "[", "A", "]"}], ",", " ", 
             RowBox[{"(*", "else", "*)"}], "\n", "                ", 
             RowBox[{"PartialTraceGeneral", "[", 
              RowBox[{"A", ",", "dim", ",", "sys"}], "]"}]}], "\n", 
            "        \t", "]"}], ",", "\n", "        ", 
           RowBox[{"(*", "else", "*)"}], "\n", "            ", 
           RowBox[{"Message", "[", 
            RowBox[{
             RowBox[{"PartialTrace", "::", "sysspecerr"}], ",", " ", 
             RowBox[{"Length", "[", "dim", "]"}], ",", " ", 
             RowBox[{"Select", "[", 
              RowBox[{"sys", ",", " ", 
               RowBox[{
                RowBox[{"Or", "[", 
                 RowBox[{
                  RowBox[{"#", ">", 
                   RowBox[{"Length", "[", "dim", "]"}]}], ",", "  ", 
                  RowBox[{"#", " ", "<", " ", "1"}]}], "]"}], "&"}]}], 
              "]"}]}], "]"}]}], "\n", "        ", "]"}]}], "\n", "    ", 
        "]"}]}]}], "\n", "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"PartialTrace", "::", "syserr"}], " ", "=", 
   " ", "\"\<The second argument is expected to be 1, 2 or {1,2} (`1` was \
given)\>\""}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"PartialTrace", "::", "dimerr"}], " ", "=", 
   " ", "\"\<This function expects square matrix of size d^2\[Times]d^2 (the \
matrix of size `1` was given)\>\""}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"PartialTrace", "::", "sysspecerr"}], " ", "=", 
    " ", "\"\<The system specification is invalid. In the case of `1`-partite \
systems, it is inpossible to trace out with respect to sub-systems \
`2`.\>\""}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"PartialTrace1", "[", "X_", "]"}], " ", ":=", " ", 
   RowBox[{"Block", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"d", " ", "=", " ", 
       RowBox[{"Sqrt", "[", 
        RowBox[{"Length", "[", "X", "]"}], "]"}]}], "}"}], ",", " ", 
     RowBox[{"Total", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"X", "[", 
         RowBox[{"[", 
          RowBox[{
           RowBox[{
            RowBox[{"1", " ", "+", " ", 
             RowBox[{"d", " ", "#"}]}], " ", ";;", " ", 
            RowBox[{"d", " ", "+", " ", 
             RowBox[{"d", " ", "#"}]}]}], ",", " ", 
           RowBox[{
            RowBox[{"1", " ", "+", " ", 
             RowBox[{"d", " ", "#"}]}], " ", ";;", " ", 
            RowBox[{"d", " ", "+", " ", 
             RowBox[{"d", " ", "#"}]}]}]}], " ", "]"}], "]"}], " ", "&"}], 
       " ", "/@", " ", 
       RowBox[{"Range", "[", 
        RowBox[{"0", ",", " ", 
         RowBox[{"d", " ", "-", " ", "1"}]}], "]"}]}], "]"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"PartialTrace2", "[", "X_", "]"}], " ", ":=", " ", 
   RowBox[{"Block", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"d", " ", "=", " ", 
       RowBox[{"Sqrt", "[", 
        RowBox[{"Length", "[", "X", "]"}], "]"}]}], "}"}], ",", " ", 
     RowBox[{"Total", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"X", "[", 
         RowBox[{"[", 
          RowBox[{
           RowBox[{
            RowBox[{"1", " ", "+", " ", "#"}], " ", ";;", " ", 
            RowBox[{"d", "^", "2"}], " ", ";;", " ", "d"}], ",", " ", 
           RowBox[{
            RowBox[{"1", " ", "+", " ", "#"}], " ", ";;", " ", 
            RowBox[{"d", "^", "2"}], " ", ";;", " ", "d"}]}], "]"}], "]"}], 
        " ", "&"}], " ", "/@", " ", 
       RowBox[{"Range", "[", 
        RowBox[{"0", ",", " ", 
         RowBox[{"d", " ", "-", " ", "1"}]}], "]"}]}], "]"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"PartialTrace1", "[", 
    RowBox[{"X_", ",", " ", 
     RowBox[{"{", 
      RowBox[{"d1_", ",", " ", "d2_"}], "}"}]}], "]"}], " ", ":=", " ", 
   RowBox[{"Total", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"X", "[", 
       RowBox[{"[", 
        RowBox[{
         RowBox[{
          RowBox[{"1", " ", "+", " ", 
           RowBox[{"d2", " ", "#"}]}], " ", ";;", " ", 
          RowBox[{"d2", " ", "+", " ", 
           RowBox[{"d2", " ", "#"}]}]}], ",", " ", 
         RowBox[{
          RowBox[{"1", " ", "+", " ", 
           RowBox[{"d2", " ", "#"}]}], " ", ";;", " ", 
          RowBox[{"d2", " ", "+", " ", 
           RowBox[{"d2", " ", "#"}]}]}]}], " ", "]"}], "]"}], " ", "&"}], " ",
      "/@", " ", 
     RowBox[{"Range", "[", 
      RowBox[{"0", ",", " ", 
       RowBox[{"d1", " ", "-", " ", "1"}]}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"PartialTrace2", "[", 
     RowBox[{"X_", ",", " ", 
      RowBox[{"{", 
       RowBox[{"d1_", ",", " ", "d2_"}], "}"}]}], "]"}], " ", ":=", " ", 
    RowBox[{"Total", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"X", "[", 
        RowBox[{"[", 
         RowBox[{
          RowBox[{
           RowBox[{"1", " ", "+", " ", "#"}], " ", ";;", " ", 
           RowBox[{"d1", "*", "d2"}], " ", ";;", " ", "d2"}], ",", " ", 
          RowBox[{
           RowBox[{"1", " ", "+", " ", "#"}], " ", ";;", " ", 
           RowBox[{"d1", "*", "d2"}], " ", ";;", " ", "d2"}]}], "]"}], "]"}], 
       " ", "&"}], " ", "/@", " ", 
      RowBox[{"Range", "[", 
       RowBox[{"0", ",", " ", 
        RowBox[{"d2", " ", "-", " ", "1"}]}], "]"}]}], "]"}]}], ";"}], "\n"}],
 "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"ListReshape", "[", 
     RowBox[{"list_", ",", " ", "shape_"}], "]"}], " ", ":=", " ", "\n", "  ", 
    RowBox[{"FlattenAt", "[", 
     RowBox[{
      RowBox[{"Fold", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Partition", "[", 
          RowBox[{"#1", ",", " ", "#2"}], "]"}], " ", "&"}], ",", " ", 
        RowBox[{"Flatten", "[", "list", "]"}], ",", " ", 
        RowBox[{"Reverse", "[", "shape", "]"}]}], "]"}], ",", " ", "\n", 
      "   ", "1"}], "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"PartialTraceGeneral", "[", 
     RowBox[{"A_", ",", 
      RowBox[{"dim_", "?", "VectorQ"}], ",", 
      RowBox[{"sys_", "?", "VectorQ"}]}], "]"}], " ", ":=", " ", 
    RowBox[{"Block", "[", "\n", "\t", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "offset", ",", " ", "keep", ",", " ", "dispose", ",", " ", "keepdim", ",",
         " ", "disposedim", ",", " ", "perm1", ",", " ", "perm2", ",", " ", 
        "perm", ",", " ", "tensor"}], "}"}], ",", "\n", "\t", 
      RowBox[{
       RowBox[{"offset", "=", 
        RowBox[{"Length", "[", "dim", "]"}]}], ";", "\n", "\t", 
       RowBox[{"keep", "=", 
        RowBox[{"Complement", "[", 
         RowBox[{
          RowBox[{"Range", "[", "offset", "]"}], ",", " ", "sys"}], "]"}]}], ";",
        "\n", "\t", 
       RowBox[{"dispose", "=", 
        RowBox[{"Union", "[", "sys", "]"}]}], ";", "\n", "\t", 
       RowBox[{"perm1", "=", 
        RowBox[{"Join", "[", 
         RowBox[{"dispose", ",", "keep"}], "]"}]}], ";", "\n", "\t", 
       RowBox[{"perm2", "=", 
        RowBox[{"perm1", "+", "offset"}]}], ";", "\n", "\t", 
       RowBox[{"perm", "=", 
        RowBox[{"Ordering", "[", 
         RowBox[{"Join", "[", 
          RowBox[{"perm1", ",", "perm2"}], "]"}], "]"}]}], ";", "\n", "\t", 
       RowBox[{"tensor", "=", 
        RowBox[{"ListReshape", "[", 
         RowBox[{"A", ",", " ", 
          RowBox[{"Join", "[", 
           RowBox[{"dim", ",", "dim"}], "]"}]}], "]"}]}], ";", "\n", "\t", 
       RowBox[{"keepdim", "=", 
        RowBox[{"Apply", "[", 
         RowBox[{"Times", ",", " ", 
          RowBox[{
           RowBox[{"Join", "[", 
            RowBox[{"dim", ",", " ", "dim"}], "]"}], "[", 
           RowBox[{"[", "keep", "]"}], "]"}]}], "]"}]}], ";", "\n", "\t", 
       RowBox[{"disposedim", "=", 
        RowBox[{"Apply", "[", 
         RowBox[{"Times", ",", " ", 
          RowBox[{
           RowBox[{"Join", "[", 
            RowBox[{"dim", ",", " ", "dim"}], "]"}], "[", 
           RowBox[{"[", "dispose", "]"}], "]"}]}], "]"}]}], ";", "\n", "\t", 
       RowBox[{"tensor", "=", 
        RowBox[{"Transpose", "[", 
         RowBox[{"tensor", ",", "perm"}], "]"}]}], ";", "\n", "\t", 
       RowBox[{"tensor", "=", 
        RowBox[{"ListReshape", "[", 
         RowBox[{"tensor", ",", 
          RowBox[{"{", 
           RowBox[{
           "disposedim", ",", "keepdim", ",", "disposedim", ",", "keepdim"}], 
           "}"}]}], "]"}]}], ";", "\n", "\t", 
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{"tensor", "[", 
          RowBox[{"[", 
           RowBox[{"i", ",", "All", ",", "i", ",", "All"}], "]"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "1", ",", "disposedim"}], "}"}]}], "]"}]}]}], 
     "\n", "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"PartialTranspose", "[", 
    RowBox[{"\[Rho]_", ",", 
     RowBox[{"dim_", "?", "VectorQ"}], ",", 
     RowBox[{"sys_", "?", "VectorQ"}]}], "]"}], ":=", 
   RowBox[{"Block", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "offset", ",", "tensor", ",", "perm", ",", "idx1", ",", "idx2", ",", 
       "s", ",", "targetsys"}], "}"}], ",", "\n", "\t", 
     RowBox[{
      RowBox[{"offset", "=", 
       RowBox[{"Length", "[", "dim", "]"}]}], ";", "\n", "\t", 
      RowBox[{"tensor", "=", 
       RowBox[{"ListReshape", "[", 
        RowBox[{"\[Rho]", ",", " ", 
         RowBox[{"Join", "[", 
          RowBox[{"dim", ",", "dim"}], "]"}]}], "]"}]}], ";", "\n", "\t", 
      RowBox[{"targetsys", "=", 
       RowBox[{"Union", "[", "sys", "]"}]}], ";", "\n", "\t", 
      RowBox[{"perm", "=", 
       RowBox[{"Range", "[", 
        RowBox[{"offset", "*", "2"}], "]"}]}], ";", "\n", "\t", 
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{"s", "=", "1"}], ",", " ", 
        RowBox[{"s", "<=", 
         RowBox[{"Length", "[", "targetsys", "]"}]}], ",", " ", 
        RowBox[{"s", "+=", "1"}], ",", " ", "\n", "\t\t", 
        RowBox[{
         RowBox[{"idx1", " ", "=", " ", 
          RowBox[{
           RowBox[{"Position", "[", 
            RowBox[{"perm", ",", " ", 
             RowBox[{"targetsys", "[", 
              RowBox[{"[", "s", "]"}], "]"}]}], "]"}], "[", 
           RowBox[{"[", 
            RowBox[{"1", ",", " ", "1"}], "]"}], "]"}]}], ";", "\n", "\t\t", 
         RowBox[{"idx2", " ", "=", " ", 
          RowBox[{
           RowBox[{"Position", "[", 
            RowBox[{"perm", ",", " ", 
             RowBox[{
              RowBox[{"targetsys", "[", 
               RowBox[{"[", "s", "]"}], "]"}], " ", "+", " ", "offset"}]}], 
            "]"}], "[", 
           RowBox[{"[", 
            RowBox[{"1", ",", " ", "1"}], "]"}], "]"}]}], ";", "\n", "\t\t", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"perm", "[", 
             RowBox[{"[", "idx1", "]"}], "]"}], ",", 
            RowBox[{"perm", "[", 
             RowBox[{"[", "idx2", "]"}], "]"}]}], "}"}], "=", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"perm", "[", 
             RowBox[{"[", "idx2", "]"}], "]"}], ",", 
            RowBox[{"perm", "[", 
             RowBox[{"[", "idx1", "]"}], "]"}]}], "}"}]}], ";"}]}], "\n", 
       "\t", "]"}], ";", "\n", "\t", 
      RowBox[{"tensor", "=", 
       RowBox[{"Transpose", "[", 
        RowBox[{"tensor", ",", 
         RowBox[{"InversePermutation", "[", "perm", "]"}]}], "]"}]}], ";", 
      "\n", "\t", 
      RowBox[{"ListReshape", "[", 
       RowBox[{"tensor", ",", 
        RowBox[{"Dimensions", "[", "\[Rho]", "]"}]}], "]"}]}]}], "\n", 
    "]"}]}], ";"}]}], "Code",
 CellLabel->"In[72]:=",ExpressionUUID->"698a04e4-323b-474f-bcd1-ee21b5343892"]
