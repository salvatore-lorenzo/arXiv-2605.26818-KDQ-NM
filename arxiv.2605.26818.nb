Cell["\<\
Comment: Evaluates the RHP-style CP-divisibility witness from the \
intermediate maps, using Choi-matrix and trace-norm/eigenvalue diagnostics.\
\>", "Text",ExpressionUUID->"08697969-46a2-4271-b143-8e3c2f0e8d78"],

Cell[BoxData[{
 RowBox[{"Clear", "[", "choi", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"choi", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"Chop", "@", 
      RowBox[{"(", 
       RowBox[{
        FractionBox["1", "2"], 
        RowBox[{"Sum", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"v1", "\[CircleDot]", "v2"}], ")"}], "\[CircleTimes]", 
           RowBox[{"Partition", "[", 
            RowBox[{
             RowBox[{"#", ".", 
              RowBox[{"Flatten", "[", 
               RowBox[{"(", 
                RowBox[{"v1", "\[CircleDot]", "v2"}], ")"}], "]"}]}], ",", 
             "2"}], "]"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"v1", ",", 
            RowBox[{"{", 
             RowBox[{"m", ",", "p"}], "}"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"v2", ",", 
            RowBox[{"{", 
             RowBox[{"m", ",", "p"}], "}"}]}], "}"}]}], "]"}]}], ")"}]}], 
     "&"}], "/@", "LStl"}]}], ";"}]}], "Input",
