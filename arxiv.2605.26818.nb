Cell["\<\
Comment: Evaluates the RHP-style CP-divisibility witness from the \
intermediate maps, using Choi-matrix and trace-norm/eigenvalue diagnostics.\
\>", "Text",ExpressionUUID->"dc06ee3a-7661-4ae8-b94a-cc074ed5fc1b"],

Cell[BoxData[{
 RowBox[{"Clear", "[", "choi", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"choi", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"Chop", "@", 
      RowBox[{"(", 
       RowBox[{
        FractionBox["1", "2"], 
        RowBox[{"Sum", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"v1", "\[CircleDot]", "v2"}], ")"}], "\[CircleTimes]", 
           RowBox[{"Partition", "[", 
            RowBox[{
             RowBox[{"#", ".", 
              RowBox[{"Flatten", "[", 
               RowBox[{"(", 
                RowBox[{"v1", "\[CircleDot]", "v2"}], ")"}], "]"}]}], ",", 
