Cell[CellGroupData[{

Cell["Von Neumann, Mutual Information", "Subsection",
 CellChangeTimes->{{3.989986880112769*^9, 
  3.989986881531654*^9}},ExpressionUUID->"bdb9fd80-00e5-4ec1-bc98-\
0ed772c586c0"],

Cell["\<\
Comment: Collects entropy and information-theoretic utilities, including von \
Neumann entropy and mutual information. These are used for the LFS-style \
non-Markovianity diagnostics.\
\>", "Text",ExpressionUUID->"a611aa3c-b4d4-4c2a-a117-a5f2094dee4e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"vonNeumann", "[", 
   RowBox[{"\[Rho]_", ",", 
    RowBox[{"base_", ":", "2"}]}], "]"}], ":=", " ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"eigs", ",", "func"}], "}"}], ",", "\n", "\t", 
    RowBox[{
     RowBox[{"eigs", " ", "=", " ", 
      RowBox[{"Eigenvalues", "[", "\[Rho]", "]"}]}], ";", "\n", "\t", 
     RowBox[{
      RowBox[{"func", "[", "x_", "]"}], ":=", " ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"NumberQ", "[", "x", "]"}], "&&", 
         RowBox[{
          RowBox[{"Re", "@", "x"}], "<", 
          RowBox[{"10", "^", 
           RowBox[{"-", "12"}]}]}]}], ",", "0", ",", 
        RowBox[{
         RowBox[{"-", "x"}], " ", 
         RowBox[{"Log", "[", 
          RowBox[{"base", ",", "x"}], "]"}]}]}], "]"}]}], ";", "\n", "\t", 
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{"func", "[", 
        RowBox[{"eigs", "[", 
         RowBox[{"[", "i", "]"}], "]"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", 
         RowBox[{"Length", "@", "eigs"}]}], "}"}]}], "]"}]}]}], 
   "]"}]}]], "Code",
 CellLabel->
  "In[215]:=",ExpressionUUID->"752dd6d5-10f7-4cac-a863-169e7a441748"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"MutualInformation", "[", 
     RowBox[{"\[Rho]_", ",", "locdimlist_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\[Rho]A", ",", "\[Rho]B", ",", "\[Rho]AB", ",", "n"}], "}"}], 
      ",", "\n", "\t", 
      RowBox[{
       RowBox[{"n", "=", " ", 
        RowBox[{"Length", "@", "locdimlist"}]}], ";", "\n", "\t", 
       RowBox[{"\[Rho]A", " ", "=", " ", 
        RowBox[{"PartialTrace", "[", 
         RowBox[{"\[Rho]", ",", "locdimlist", ",", 
          RowBox[{"{", "1", "}"}]}], "]"}]}], ";", "\n", "\t", 
       RowBox[{"\[Rho]B", " ", "=", " ", 
        RowBox[{"PartialTrace", "[", 
         RowBox[{"\[Rho]", ",", "locdimlist", ",", 
          RowBox[{"{", "2", "}"}]}], "]"}]}], ";", "\n", "\t", 
       RowBox[{"Chop", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"vonNeumann", "[", "\[Rho]A", "]"}], "+", 
          RowBox[{"vonNeumann", "[", "\[Rho]B", "]"}], "-", 
          RowBox[{"vonNeumann", "[", "\[Rho]", "]"}]}], ",", 
         RowBox[{"10", "^", 
          RowBox[{"-", "12"}]}]}], "]"}]}]}], "]"}]}], ";"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{"When", " ", "subsystems", " ", "are", " ", "qubits"}], " ", 
   "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"MutualInformation", "[", "\[Rho]_", "]"}], ":=", " ", 
  RowBox[{"MutualInformation", "[", 
   RowBox[{"\[Rho]", ",", 
    RowBox[{"{", 
     RowBox[{"2", ",", "2"}], "}"}]}], "]"}]}]}], "Code",
 CellChangeTimes->{{3.9899868704253893`*^9, 3.989986870876232*^9}},
 CellLabel->
  "In[216]:=",ExpressionUUID->"e70dbf7a-ad38-4f22-93ea-336d16005a6b"]
}, Closed]]
