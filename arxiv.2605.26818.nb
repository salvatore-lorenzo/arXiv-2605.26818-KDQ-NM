Cell[CellGroupData[{

Cell["Qubits Systems", "Subsection",ExpressionUUID->"56d59235-e99a-4ea1-a898-e5853328386b"],

Cell["\<\
Comment: Defines NQubits[NN], which constructs sparse many-qubit spin \
operators Sx[i], Sy[i], Sz[i], Sp[i], and Sm[i] acting on site i of an \
NN-qubit register.\
\>", "Text",ExpressionUUID->"db74fe1d-4779-479f-827e-ba13b299e616"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"NQubits", "[", "NN_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "\[Sigma]0", ",", "\[Sigma]x", ",", "\[Sigma]y", ",", "\[Sigma]z", ",", 
       "\[Sigma]p", ",", "\[Sigma]m", ",", "eye", ",", "eyeL", ",", "eyeR"}], 
      "}"}], ",", "\n", 
     RowBox[{
      RowBox[{"\[Sigma]0", " ", "=", " ", 
       RowBox[{"SparseArray", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"1", ",", "0"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"0", ",", "1"}], "}"}]}], "}"}], "]"}]}], ";", "\n", 
      RowBox[{"\[Sigma]x", " ", "=", " ", 
       RowBox[{"SparseArray", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0", ",", "1"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"1", ",", "0"}], "}"}]}], "}"}], "]"}]}], ";", "\n", 
      RowBox[{"\[Sigma]y", " ", "=", " ", 
       RowBox[{"SparseArray", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0", ",", 
            RowBox[{"-", "I"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"I", ",", "0"}], "}"}]}], "}"}], "]"}]}], ";", "\n", 
      RowBox[{"\[Sigma]z", " ", "=", 
       RowBox[{"SparseArray", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"1", ",", "0"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"0", ",", 
            RowBox[{"-", "1"}]}], "}"}]}], "}"}], "]"}]}], ";", "\n", 
      RowBox[{"\[Sigma]p", " ", "=", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"\[Sigma]x", " ", "-", " ", 
          RowBox[{"I", " ", "\[Sigma]y"}]}], ")"}], "/", "2"}]}], ";", 
      RowBox[{"\[Sigma]m", " ", "=", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"\[Sigma]x", " ", "+", " ", 
          RowBox[{"I", " ", "\[Sigma]y"}]}], ")"}], "/", "2"}]}], ";", "\n", 
      RowBox[{"eye", " ", "=", " ", 
       RowBox[{"Id", "[", 
        RowBox[{"2", "^", "NN"}], "]"}]}], ";", "\n", 
      RowBox[{"Do", "[", "\n", 
       RowBox[{
        RowBox[{
         RowBox[{"eyeL", " ", "=", " ", 
          RowBox[{"Id", "[", 
           RowBox[{"2", "^", 
            RowBox[{"(", 
             RowBox[{"i", "-", "1"}], ")"}]}], "]"}]}], ";", "\n", 
         RowBox[{"eyeR", " ", "=", " ", 
          RowBox[{"Id", "[", 
           RowBox[{"2", "^", 
            RowBox[{"(", 
             RowBox[{"NN", "-", "i"}], ")"}]}], "]"}]}], ";", "\n", 
         RowBox[{
          RowBox[{"Sx", "[", "i", "]"}], " ", "=", " ", 
          RowBox[{"SparseArray", "[", 
           RowBox[{"CircleTimes", "[", 
            RowBox[{"eyeL", ",", "\[Sigma]x", ",", "eyeR"}], "]"}], "]"}]}], ";",
          "\n", 
         RowBox[{
          RowBox[{"Sy", "[", "i", "]"}], " ", "=", " ", 
          RowBox[{"SparseArray", "[", 
           RowBox[{"CircleTimes", "[", 
            RowBox[{"eyeL", ",", "\[Sigma]y", ",", "eyeR"}], "]"}], "]"}]}], ";",
          "\n", 
         RowBox[{
          RowBox[{"Sz", "[", "i", "]"}], " ", "=", " ", 
          RowBox[{"SparseArray", "[", 
           RowBox[{"CircleTimes", "[", 
            RowBox[{"eyeL", ",", "\[Sigma]z", ",", "eyeR"}], "]"}], "]"}]}], ";",
          "\n", 
         RowBox[{
          RowBox[{"Sp", "[", "i", "]"}], " ", "=", " ", 
          RowBox[{"SparseArray", "[", 
           RowBox[{"CircleTimes", "[", 
            RowBox[{"eyeL", ",", "\[Sigma]p", ",", "eyeR"}], "]"}], "]"}]}], ";",
          "\n", 
         RowBox[{
          RowBox[{"Sm", "[", "i", "]"}], " ", "=", " ", 
          RowBox[{"SparseArray", "[", 
           RowBox[{"CircleTimes", "[", 
            RowBox[{"eyeL", ",", "\[Sigma]m", ",", "eyeR"}], "]"}], "]"}]}], 
         ";"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", "NN"}], "}"}]}], "]"}], ";"}]}], "]"}]}],
   ";"}]], "Code",
 CellLabel->"In[61]:=",ExpressionUUID->"ac509d05-835f-4af1-8f95-e046f36f7d77"]
}, Closed]],

Cell[CellGroupData[{

Cell["Reshaping, vectorization and reshuffling", "Subsection",ExpressionUUID->"8a77c676-b276-4ad0-94cb-35fc647aee92"],

Cell["\<\
Comment: Defines vectorization, inverse vectorization, row-wise reshaping, \
and reshuffling maps used to move between states, superoperators, and \
Choi-matrix representations.\
\>", "Text",ExpressionUUID->"6dfb1f9d-2935-4bdf-a3d7-4427bda43579"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Vec", "[", "m_", "]"}], ":=", 
    RowBox[{"Flatten", "[", 
     RowBox[{"Transpose", "[", "m", "]"}], "]"}]}], ";"}], " ", "\n"}], "\n", 

 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Unvec", "[", 
     RowBox[{"v_List", ",", 
      RowBox[{"cols_", ":", "0"}]}], "]"}], ":=", 
    RowBox[{"Which", "[", "\n", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"cols", "==", " ", "0"}], ")"}], "&&", 
       RowBox[{"IntegerQ", "[", 
        RowBox[{"\[Sqrt]", 
         RowBox[{"Length", "[", "v", "]"}]}], "]"}]}], ",", 
      RowBox[{"Transpose", "[", 
       RowBox[{"Partition", "[", 
        RowBox[{"v", ",", 
         RowBox[{"\[Sqrt]", 
          RowBox[{"Length", "[", "v", "]"}]}]}], "]"}], "]"}], ",", "\n", " ", 
      RowBox[{
       RowBox[{"Mod", "[", 
        RowBox[{
         RowBox[{"Length", "[", "v", "]"}], ",", "cols"}], "]"}], "==", "0"}],
       ",", 
      RowBox[{"Transpose", "[", 
       RowBox[{"Partition", "[", 
        RowBox[{"v", ",", "cols"}], "]"}], "]"}]}], "\n", "]"}]}], ";"}], 
  "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Res", "[", "m_List", "]"}], ":=", 
    RowBox[{"Flatten", "[", "m", "]"}]}], ";"}], " ", "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Unres", "[", 
     RowBox[{"v_List", ",", 
      RowBox[{"cols_", ":", "0"}]}], "]"}], ":=", 
    RowBox[{"Which", "[", "\n", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"cols", "==", " ", "0"}], ")"}], "&&", 
       RowBox[{"IntegerQ", "[", 
        RowBox[{"\[Sqrt]", 
         RowBox[{"Length", "[", "v", "]"}]}], "]"}]}], ",", 
      RowBox[{"Partition", "[", 
       RowBox[{"v", ",", 
        RowBox[{"\[Sqrt]", 
         RowBox[{"Length", "[", "v", "]"}]}]}], "]"}], ",", "\n", " ", 
      RowBox[{
       RowBox[{"Mod", "[", 
        RowBox[{
         RowBox[{"Length", "[", "v", "]"}], ",", "cols"}], "]"}], "==", "0"}],
       ",", 
      RowBox[{"Partition", "[", 
       RowBox[{"v", ",", "cols"}], "]"}]}], "\n", "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{"Reshuffle", "[", "\[Rho]_", "]"}], ":=", 
  RowBox[{"Block", "[", 
   RowBox[{
    RowBox[{"{", "dim", "}"}], ",", "\n", "\t", 
    RowBox[{
     RowBox[{"dim", " ", "=", " ", 
      RowBox[{"Sqrt", "[", 
       RowBox[{"Length", "[", "\[Rho]", "]"}], "]"}]}], ";", "\n", "\t", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"And", " ", "[", 
        RowBox[{
         RowBox[{"SquareMatrixQ", "[", "\[Rho]", "]"}], " ", ",", " ", 
         RowBox[{"IntegerQ", "[", "dim", "]"}]}], "]"}], " ", ",", "\n", 
       "\t\t", 
       RowBox[{"Reshuffle", "[", 
        RowBox[{"\[Rho]", ",", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"dim", ",", "dim"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"dim", ",", "dim"}], "}"}]}], "}"}]}], "]"}], "\n", "\t", 
       
       RowBox[{"(*", "else", "*)"}], ",", "\n", "\t\t", 
       RowBox[{"Message", "[", 
        RowBox[{"Reshuffle", "::", "argerr"}], "]"}]}], "\n", "\t", "]"}]}]}],
    "\n", "]"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Reshuffle", "::", "argerr"}], " ", "=", 
    " ", "\"\<Reshuffle works only for square matrices of dimension \
\\!\\(\\*SuperscriptBox[\\\"d\\\", \
\\\"2\\\"]\\)\[Times]\\!\\(\\*SuperscriptBox[\\\"d\\\", \\\"2\\\"]\\), \\\n\
where d is an Integer, for other dimensions use ReshuffleGeneral\>\""}], 
   ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Reshuffle", "[", 
    RowBox[{"A_", ",", 
     RowBox[{"{", 
      RowBox[{"n_", ",", "m_"}], "}"}]}], "]"}], ":=", 
   RowBox[{"Flatten", "[", "\n", "\t", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Flatten", "[", 
        RowBox[{"Part", "[", 
         RowBox[{"A", ",", 
          RowBox[{
           RowBox[{"1", "+", "i1"}], ";;", 
           RowBox[{
            RowBox[{"n", "[", 
             RowBox[{"[", "2", "]"}], "]"}], "+", "i1"}]}], ",", 
          RowBox[{
           RowBox[{"1", "+", "i2"}], ";;", 
           RowBox[{
            RowBox[{"m", "[", 
             RowBox[{"[", "2", "]"}], "]"}], "+", "i2"}]}]}], "]"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i1", ",", "0", ",", 
         RowBox[{
          RowBox[{
           RowBox[{"n", "[", 
            RowBox[{"[", "1", "]"}], "]"}], " ", 
           RowBox[{"n", "[", 
            RowBox[{"[", "2", "]"}], "]"}]}], "-", "1"}], ",", 
         RowBox[{"n", "[", 
          RowBox[{"[", "2", "]"}], "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"i2", ",", "0", ",", 
         RowBox[{
          RowBox[{
           RowBox[{"m", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "*", 
           RowBox[{"m", "[", 
            RowBox[{"[", "2", "]"}], "]"}]}], "-", "1"}], ",", 
         RowBox[{"m", "[", 
          RowBox[{"[", "2", "]"}], "]"}]}], "}"}]}], "]"}], "\n", ",", "1"}], 
    "]"}]}], ";"}]}], "Code",
 CellLabel->"In[62]:=",ExpressionUUID->"7aee248a-3a4f-4059-8308-93e8138b5508"]
}, Closed]],

Cell[CellGroupData[{

Cell["Partial trace and transposition", "Subsection",ExpressionUUID->"a552548e-a3bf-473c-a226-7078de6b68e9"],

Cell["\<\
Comment: Defines partial trace and partial-transposition utilities for \
composite Hilbert spaces. Later sections use these routines to extract \
reduced S, M, and E states and to manipulate bipartitions.\
\>", "Text",ExpressionUUID->"905e561a-8c48-4f02-a0a0-bfcb8031f0a2"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"PartialTrace", "[", 
    RowBox[{"A_", ",", " ", 
     RowBox[{"{", "}"}]}], "]"}], ":=", "A"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"PartialTrace", "[", 
     RowBox[{"A_", ",", " ", "dim_", ",", " ", 
      RowBox[{"{", "}"}]}], "]"}], ":=", "A"}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"PartialTrace", "[", 
    RowBox[{"A_", ",", " ", "s_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Block", "[", " ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"d", " ", "=", " ", 
        RowBox[{"Length", "[", "A", "]"}]}], ",", " ", "sys"}], "}"}], ",", 
     "\n", "    ", 
     RowBox[{
      RowBox[{"If", "[", " ", 
       RowBox[{
        RowBox[{"IntegerQ", "[", "s", "]"}], ",", "\n", "      ", 
        RowBox[{"sys", " ", "=", " ", 
         RowBox[{"{", "s", "}"}]}], ",", " ", 
        RowBox[{"(*", "else", "*)"}], "\n", "      ", 
        RowBox[{"sys", " ", "=", " ", "s"}]}], "\n", "    ", "]"}], ";", "  ",
       "\n", "    ", 
      RowBox[{"If", "[", "  ", 
       RowBox[{
        RowBox[{"IntegerQ", "[", 
         RowBox[{"Sqrt", "[", "d", "]"}], "]"}], ",", "\n", "    ", 
        RowBox[{"If", "[", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"Length", "[", "sys", "]"}], "==", "1"}], " ", ",", "\n", 
          "      ", 
          RowBox[{"Switch", "[", 
           RowBox[{
            RowBox[{"sys", "[", 
             RowBox[{"[", "1", "]"}], "]"}], ",", "\n", "       ", "1", ",", 
            " ", 
            RowBox[{"PartialTrace1", "[", "A", "]"}], ",", "\n", "       ", 
            "2", ",", " ", 
            RowBox[{"PartialTrace2", "[", "A", "]"}], ",", "\n", "       ", 
            "_", ",", 
            RowBox[{
             RowBox[{"Print", "[", "\"\<B1\>\"", "]"}], ";", " ", 
             RowBox[{"Message", "[", 
              RowBox[{
               RowBox[{"PartialTrace", "::", "syserr"}], ",", " ", "sys"}], 
              "]"}]}]}], "\n", "       ", "]"}], ",", " ", 
          RowBox[{"(*", "else", "*)"}], "\n", "      ", 
          RowBox[{"If", "[", " ", 
           RowBox[{
            RowBox[{
             RowBox[{"sys", "==", 
