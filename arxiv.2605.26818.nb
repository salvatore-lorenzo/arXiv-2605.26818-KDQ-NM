Cell[BoxData[{
 RowBox[{
  RowBox[{"vecKDQ\[CapitalDelta]ESarray", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Flatten", "@", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Tr", "[", 
         RowBox[{
          RowBox[{"ProjES", "[", 
           RowBox[{"[", "j", "]"}], "]"}], ".", 
          RowBox[{"Partition", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"LStl", "[", 
              RowBox[{"[", "n", "]"}], "]"}], ".", 
             RowBox[{"Flatten", "[", 
              RowBox[{
               RowBox[{"ProjES", "[", 
                RowBox[{"[", "k", "]"}], "]"}], ".", 
               RowBox[{"\[Rho]S", "[", 
                RowBox[{"[", "n", "]"}], "]"}]}], "]"}]}], ",", "2"}], 
           "]"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"j", ",", "1", ",", "2"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"k", ",", "1", ",", "2"}], "}"}]}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"n", ",", "1", ",", 
       RowBox[{"Nsteps", "-", "2"}]}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"negq\[CapitalDelta]ESarray", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"Chop", "[", 
      RowBox[{
       RowBox[{"-", "1"}], "+", 
       RowBox[{"Total", "[", 
        RowBox[{"Abs", "[", "#", "]"}], "]"}]}], "]"}], "&"}], "/@", 
    "vecKDQ\[CapitalDelta]ESarray"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"negq\[CapitalDelta]ESarray2", "=", 
   RowBox[{"Chop", "[", 
    RowBox[{
     RowBox[{"-", "1"}], "+", 
     RowBox[{
      RowBox[{"\[Rho]S", "[", 
