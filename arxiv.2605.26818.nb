   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"MutualInformation", "[", 
       RowBox[{"Partition", "[", 
        RowBox[{
         RowBox[{"P", ".", 
          RowBox[{"(", 
           RowBox[{
