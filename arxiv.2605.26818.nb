               RowBox[{"1", ",", "2"}], "}"}]}], " ", "||", " ", 
             RowBox[{"sys", "==", 
              RowBox[{"{", 
               RowBox[{"2", ",", "1"}], "}"}]}]}], ",", "\n", "        ", 
            RowBox[{"Tr", "[", "A", "]"}], ",", " ", 
            RowBox[{"(*", "else", "*)"}], "\n", "        ", 
